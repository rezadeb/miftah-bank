# ============================================================================
# Miftah Bank - Load Balancer (nginx)
#
#   Browser -> Ingress -> nginx :8080 -> frontend :3000 (Node.js)
#
# This file is a template. When the container starts, the official nginx entrypoint fills in
# ${NGINX_RESOLVER}, ${FRONTEND_UPSTREAM} and ${FRONTEND_PROXY_PASS} (envsubst).
#
# FRONTEND_PROXY_MODE (set in 05-resolver.envsh) decides how nginx calls the frontend:
#   static  (default) proxy_pass http://frontend...:3000  - the name is resolved once, when nginx starts.
#   dynamic           proxy_pass $frontend                - the name is resolved on every request (resolver).
#                     nginx can start before the frontend Service exists.
# Tested on 2026-10-22: both modes give the same result in Dynatrace. The trace is linked, but
# OneAgent does not record an outgoing call, so there is no nginx -> frontend line in the Map.
#
# What users see when something is down:
#   - Frontend pod is down  -> nginx itself answers HTTP 503 (an HTML page, or JSON for /api).
#   - Frontend is up but backend, Redis or PostgreSQL is down
#                           -> the 503 from the frontend is passed through unchanged.
#   - nginx pod (this load balancer) is down -> no nginx is left to answer, so the
#                              HTTP 503 comes from the Ingress.
# ============================================================================

log_format miftah '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                  'rt=$request_time upstream=$upstream_addr us=$upstream_status';

# Only used in "dynamic" mode (proxy_pass with a variable).
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    access_log /dev/stdout miftah;
    error_log  /dev/stderr warn;

    # Do not compress HTML coming from the upstream. OneAgent must be able to inject
    # its RUM JavaScript into the HTML.
    gzip off;

    set $frontend http://${FRONTEND_UPSTREAM};   # used only in "dynamic" mode

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_send_timeout    15s;
    proxy_read_timeout    30s;

    # Health check for the Kubernetes probes. It does not depend on the frontend.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API calls: if the frontend cannot be reached, answer 503 as JSON.
    location /api/ {
        proxy_pass ${FRONTEND_PROXY_PASS};
        error_page 502 503 504 =503 /errors/frontend-unavailable.json;
    }

    # Web pages: if the frontend cannot be reached, answer 503 as an HTML page.
    location / {
        proxy_pass ${FRONTEND_PROXY_PASS};
        error_page 502 503 504 =503 /errors/frontend-unavailable.html;
    }

    location /errors/ {
        internal;
        root /usr/share/nginx/miftah;
        add_header Cache-Control "no-store" always;
    }
}
