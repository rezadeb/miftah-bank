#!/bin/sh
# The official nginx entrypoint sources this file BEFORE it runs envsubst on the templates.
# It finds the DNS server in /etc/resolv.conf (CoreDNS in K3s), unless NGINX_RESOLVER is already set.
if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER="$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf)"
fi
export NGINX_RESOLVER
